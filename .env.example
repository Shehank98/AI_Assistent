# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...   # Get at aistudio.google.com

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit this to git. Set only in Railway dashboard environment variables.
JARVIS_SECRET_KEY=

# Simple bearer token — set any strong password to protect your Railway URL
# Add X-Jarvis-Token: <value> header to all API calls
JARVIS_ACCESS_TOKEN=

# ── Google (Gmail + Calendar) ─────────────────────────────────────────────────
# 1. Create a project at console.cloud.google.com
# 2. Enable Gmail API + Google Calendar API
# 3. Create OAuth2 credentials (Desktop app type), download as client_secret.json
# 4. Run locally: python auth/google_oauth.py
# 5. Then: base64 ~/.jarvis/gmail_token.json  → paste below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_TOKEN_B64=

# ── Spotify ───────────────────────────────────────────────────────────────────
# 1. Create an app at developer.spotify.com
# 2. Grab Client ID + Secret, set redirect URI
# 3. Run locally: python auth/spotify_oauth.py
# 4. Then: base64 ~/.jarvis/spotify_token.json  → paste below
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-app.railway.app/auth/spotify
SPOTIFY_TOKEN_B64=

# ── Voice (Optional) ──────────────────────────────────────────────────────────
# ElevenLabs: free tier = 10k chars/month (elevenlabs.io)
ELEVENLABS_API_KEY=
# Voice ID — default is Adam. Find voice IDs at elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Google Cloud TTS: free 1M chars/month (alternative to ElevenLabs)
GOOGLE_TTS_KEY=

# ── News / Weather ────────────────────────────────────────────────────────────
NEWS_API_KEY=
JARVIS_LOCATION=Colombo, Sri Lanka

# ── Privacy ───────────────────────────────────────────────────────────────────
# When true: email bodies are NOT sent to Gemini API (only subject + sender)
PRIVACY_MODE=false

# ── Server ────────────────────────────────────────────────────────────────────
DESKTOP_MODE=false
PORT=8080
