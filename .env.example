# JARVIS — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Your Anthropic API key (paid)

# ── Optional: ElevenLabs TTS (best voice quality, free tier available) ────────
# ELEVENLABS_API_KEY=                 # Get free key at elevenlabs.io
# ELEVENLABS_VOICE_ID=                # Defaults to "Rachel" if not set

# ── Optional: Server config ───────────────────────────────────────────────────
# PORT=8080                           # Web server port (default 8080)
